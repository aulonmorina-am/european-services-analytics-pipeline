		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Enterprise Export Growth (YoY)' =
			
			VAR CurrentYear = SELECTEDVALUE ( DIM_YEAR[YEAR] )
			
			VAR CurrentExports =
			    CALCULATE (
			        SUM ( FCT_STEC_SERVICES_TRADE[VALUE_EUR] ),
			        DIM_FLOW[FLOW_DIRECTION] = "exports",
			        DIM_ENTERPRISE_CHARACTERISTIC[IS_REPORTING_LEVEL] = TRUE (),
			        DIM_NACE_ACTIVITY[IS_REPORTING_LEVEL] = TRUE (),
			        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
			        DIM_PARTNER[PARTNER] = "WRL_REST"
			    )
			
			VAR PreviousValue =
			    CALCULATE (
			        SUM ( FCT_STEC_SERVICES_TRADE[VALUE_EUR] ),
			        DIM_FLOW[FLOW_DIRECTION] = "exports",
			        DIM_ENTERPRISE_CHARACTERISTIC[IS_REPORTING_LEVEL] = TRUE (),
			        DIM_NACE_ACTIVITY[IS_REPORTING_LEVEL] = TRUE (),
			        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
			        DIM_PARTNER[PARTNER] = "WRL_REST",
			        REMOVEFILTERS ( DIM_YEAR ),
			        DIM_YEAR[YEAR] = CurrentYear - 1
			    )
			
			RETURN
			    IF (
			        ISBLANK ( CurrentYear ),
			        BLANK (),
			        DIVIDE ( CurrentExports - PreviousValue, PreviousValue )
			    )
		isHidden
		displayFolder: STEC_Enterprise
		lineageTag: c0a28de5-8a02-478c-a636-641f026dfb1b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Information & Communication Share' =
			VAR TotalExports =
				    CALCULATE (
				        SUM ( FCT_STEC_SERVICES_TRADE[VALUE_EUR] ),
				        DIM_FLOW[FLOW_DIRECTION] = "exports",
				        DIM_ENTERPRISE_CHARACTERISTIC[IS_REPORTING_LEVEL] = TRUE (),
				        DIM_NACE_ACTIVITY[IS_REPORTING_LEVEL] = TRUE (),
				        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
				        DIM_PARTNER[PARTNER] = "WRL_REST",
				        REMOVEFILTERS ( DIM_NACE_ACTIVITY )
				    )
				VAR NACEJExports =
				    CALCULATE (
				        SUM ( FCT_STEC_SERVICES_TRADE[VALUE_EUR] ),
				        DIM_FLOW[FLOW_DIRECTION] = "exports",
				        DIM_ENTERPRISE_CHARACTERISTIC[IS_REPORTING_LEVEL] = TRUE (),
				        DIM_NACE_ACTIVITY[IS_REPORTING_LEVEL] = TRUE (),
				        DIM_NACE_ACTIVITY[NACE_R_2] = "J",
				        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
				        DIM_PARTNER[PARTNER] = "WRL_REST"
				    )
				RETURN
				    DIVIDE ( NACEJExports, TotalExports )
		isHidden
		displayFolder: STEC_Enterprise
		lineageTag: 331dbdce-b1c0-4881-8e04-efd8a4142067

