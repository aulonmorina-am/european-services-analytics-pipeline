	measure 'Export Growth (YoY)' =
			
			VAR CurrentYear =
			    COALESCE (
			        SELECTEDVALUE ( DIM_YEAR[YEAR] ),
			        CALCULATE ( MAX ( DIM_YEAR[YEAR] ), ALLSELECTED ( DIM_YEAR ) )
			    )
			VAR CurrentExports =
			    CALCULATE (
			        SUM ( FCT_BOP_SERVICES_TRADE[VALUE_EUR] ),
			        DIM_FLOW[FLOW_DIRECTION] = "exports",
			        DIM_SERVICE[IS_REPORTING_LEVEL] = TRUE (),
			        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
			        DIM_PARTNER[PARTNER] = "WRL_REST",
			        DIM_YEAR[YEAR] = CurrentYear
			    )
			VAR PreviousValue =
			    CALCULATE (
			        SUM ( FCT_BOP_SERVICES_TRADE[VALUE_EUR] ),
			        DIM_FLOW[FLOW_DIRECTION] = "exports",
			        DIM_SERVICE[IS_REPORTING_LEVEL] = TRUE (),
			        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
			        DIM_PARTNER[PARTNER] = "WRL_REST",
			        REMOVEFILTERS ( DIM_YEAR ),
			        DIM_YEAR[YEAR] = CurrentYear - 1
			    )
			RETURN
			    DIVIDE ( CurrentExports - PreviousValue, PreviousValue )
		isHidden
		displayFolder: BOP_Trade
		lineageTag: 48bf97b3-e841-4729-ba98-d93a13763212

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ICT Share of Services Exports' = ```
				VAR TotalExports =
				    CALCULATE (
				        SUM ( FCT_BOP_SERVICES_TRADE[VALUE_EUR] ),
				        DIM_FLOW[FLOW_DIRECTION] = "exports",
				        DIM_SERVICE[IS_REPORTING_LEVEL] = TRUE (),
				        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
				        DIM_PARTNER[PARTNER] = "WRL_REST",
				        REMOVEFILTERS ( DIM_SERVICE[IS_ICT_SERVICE] )
				    )
				VAR ICTExports =
				    CALCULATE (
				        SUM ( FCT_BOP_SERVICES_TRADE[VALUE_EUR] ),
				        DIM_FLOW[FLOW_DIRECTION] = "exports",
				        DIM_SERVICE[IS_REPORTING_LEVEL] = TRUE (),
				        DIM_SERVICE[IS_ICT_SERVICE] = TRUE (),
				        DIM_GEO[IS_EU_AGGREGATE] = FALSE (),
				        DIM_PARTNER[PARTNER] = "WRL_REST"
				    )
				RETURN
				    DIVIDE ( ICTExports, TotalExports )
			```
		isHidden
		displayFolder: BOP_Trade
		lineageTag: dd47b2b6-aa1b-44ec-bf21-ae46ef4bab7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

