# Azure ADLS Gen2 account settings (extractor, local runs).
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_FILESYSTEM=your_container
AZURE_STORAGE_ROOT_PATH=raw/eurostat

# dbt Snowflake private-key passphrase. Leave empty for an unencrypted key.
# The key file itself is bind-mounted by docker-compose; only its path is set there.
DBT_PRIVATE_KEY_PASSPHRASE=
